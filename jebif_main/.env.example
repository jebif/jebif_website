# Copy to jebif_main/.env and fill in. Never commit the .env file.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# For local development over http:
# DEBUG=True
# COOKIE_SECURE=False

ALLOWED_HOSTS=jebif.fr,beta.jebif.fr
CSRF_TRUSTED_ORIGINS=https://jebif.fr,https://beta.jebif.fr
HTTP_DOMAIN=https://jebif.fr

EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=no-reply@jebif.fr
CONTACT_EMAIL=contact@jebif.fr
ADMINS=

SHOW_DEV_BANNER=False

# Behind nginx:
BEHIND_HTTPS_PROXY=False
TRUST_X_FORWARDED_FOR=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SERVE_MEDIA=True

STATIC_DIR=/var/www/jebif/staticfiles
